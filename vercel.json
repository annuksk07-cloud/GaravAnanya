{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/manifest.json",
      "headers": {
        "Content-Type": "application/manifest+json",
        "Access-Control-Allow-Origin": "*"
      },
      "dest": "/manifest.json"
    },
    {
      "src": "/sw.js",
      "headers": {
        "Content-Type": "application/javascript",
        "Cache-Control": "no-cache"
      },
      "dest": "/sw.js"
    },
    {
      "src": "/whatsapp-preview-v2.jpg",
      "headers": {
        "Content-Type": "image/jpeg",
        "Cache-Control": "public, max-age=86400"
      },
      "dest": "/whatsapp-preview-v2.jpg"
    },
    {
      "src": "/whatsapp-preview.jpg",
      "headers": {
        "Content-Type": "image/jpeg",
        "Cache-Control": "public, max-age=86400"
      },
      "dest": "/whatsapp-preview.jpg"
    },
    {
      "src": "/og-preview-v2.jpg",
      "headers": {
        "Content-Type": "image/jpeg",
        "Cache-Control": "public, max-age=86400"
      },
      "dest": "/og-preview-v2.jpg"
    },
    {
      "src": "/icon-192.png",
      "headers": {
        "Content-Type": "image/png",
        "Cache-Control": "public, max-age=86400"
      },
      "dest": "/icon-192.png"
    },
    {
      "src": "/icon-512.png",
      "headers": {
        "Content-Type": "image/png",
        "Cache-Control": "public, max-age=86400"
      },
      "dest": "/icon-512.png"
    },
    {
      "src": "/invite-v2",
      "dest": "/index.html"
    },
    {
      "src": "/invite",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
